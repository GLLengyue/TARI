# Copy this file to .env and fill in your real key.
# The runtime reads DEEPSEEK_API_KEY via the pydantic-ai DeepSeek provider.
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Narrative author endpoint (Story Mode).
# TARI falls back to evot's EVOT_LLM_* variables when TARI_LLM_* is unset,
# so sharing the local LLM that evot already uses requires no extra config.
# TARI_LLM_PROVIDER=openai
# TARI_LLM_BASE_URL=http://127.0.0.1:11434/v1
# TARI_LLM_API_KEY=ollama
# TARI_LLM_MODEL=qwen2.5:7b

# Explicit OpenRouter OpenAI-compatible endpoint:
# TARI_LLM_PROVIDER=openrouter
# TARI_LLM_BASE_URL=https://openrouter.ai/api/v1
# TARI_LLM_API_KEY=sk-or-...
# TARI_LLM_MODEL=minimax/minimax-m3:free
